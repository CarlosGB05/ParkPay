<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Reservar_Calendario"
    android:background="#279FF5">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="352dp"
        android:layout_height="652dp"
        android:layout_marginTop="15dp"

        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.493"
        app:strokeColor="#043A61"
        app:strokeWidth="5dp"
        android:background="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/linearLayout2"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="16dp"
                android:layout_marginTop="20dp">

                <Button
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:icon="@android:drawable/ic_menu_my_calendar"
                    android:text="Seleccionar Dia"
                    android:onClick="verCalendario"/>

                <TextView
                    android:id="@+id/id_text_calendario_fecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* Debe indicar un horario para continuar"
                    android:textAlignment="center"
                    android:textColor="#FFB300"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@+id/card_inicio"
                    tools:layout_editor_absoluteX="16dp" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_inicio"
                android:layout_width="0dp"
                android:layout_height="350dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toStartOf="@id/card_fin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="350dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Hora Entrada"
                        android:textColor="#333333"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/id_text_calendario_fechaInicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:text="-- / -- / ----"
                        android:textColor="#FFB300"
                        android:textSize="14sp" />

                    <ListView
                        android:id="@+id/id_text_calendario_ListviewInicio"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:divider="#DDDDDD"
                        android:dividerHeight="1dp"
                        android:textAlignment="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_fin"
                android:layout_width="0dp"
                android:layout_height="350dp"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_inicio"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="350dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Hora Salida"
                        android:textColor="#333333"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/id_text_calendario_fechaFinal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:text="-- / -- / ----"
                        android:textColor="#FFB300"
                        android:textSize="14sp" />

                    <ListView
                        android:id="@+id/id_text_calendario_ListviewFinal"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:divider="#DDDDDD"
                        android:dividerHeight="1dp"
                        android:textAlignment="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/id_text_calendario_error2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="* Debe indicar un horario para continuar"
                android:textAlignment="center"
                android:textColor="#E53935"
                android:textSize="14sp"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@+id/card_inicio"
                tools:layout_editor_absoluteX="16dp" />

            <Button
                android:id="@+id/btn_confirmar"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0C385A"
                android:onClick="confirmarHorarios"
                android:text="CONFIRMAR HORARIO"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/id_text_calendario_error2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/id_btn_parking_volver"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:text="Cancelar"
                android:textColor="@color/black"
                app:cornerRadius="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_confirmar"
                app:strokeColor="#1E293B"
                app:strokeWidth="2dp"
                android:onClick="cancelarFechas"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>