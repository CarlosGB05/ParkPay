<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Menu_Inicial"
    android:background="#279FF5">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="352dp"
        android:layout_height="652dp"
        android:layout_marginTop="15dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.493"
        app:strokeColor="#043A61"
        app:strokeWidth="5dp"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="100dp"
                android:layout_height="95dp"
                android:background="@color/white"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="400dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.044"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                app:strokeColor="#FFB300"
                app:strokeWidth="5dp"
                android:layout_marginLeft="100dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="30dp">

                <ImageView
                    android:id="@+id/id_icon_menu"
                    android:layout_width="100dp"
                    android:layout_height="95dp"
                    app:srcCompat="@mipmap/icono_default"/>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/id_btn_menu_parking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="buscarParkings"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#FFB300"
                app:strokeWidth="5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Icono Modernizado (Fondo circular suave) -->
                    <View
                        android:id="@+id/icon_bg"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/icon_parking"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Textos Organizados -->
                    <TextView
                        android:id="@+id/title_menu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Buscar Parkings"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/arrow_next"
                        app:layout_constraintStart_toEndOf="@id/icon_bg"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/subtitle_menu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Encuentra plazas libres cerca de ti"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/arrow_next"
                        app:layout_constraintStart_toStartOf="@id/title_menu"
                        app:layout_constraintTop_toBottomOf="@id/title_menu" />

                    <!-- Flecha indicativa sutil al final -->
                    <ImageView
                        android:id="@+id/arrow_next"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_flechaderecha"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#94A3B8" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/id_btn_menu_reserv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="listaReservas"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#FFB300"
                app:strokeWidth="5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Icono Modernizado (Fondo circular suave) -->
                    <View
                        android:id="@+id/icon_bg2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/icon_reservas"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Textos Organizados -->
                    <TextView
                        android:id="@+id/title_menu2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/menu_btn_reserv"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/arrow_next2"
                        app:layout_constraintStart_toEndOf="@id/icon_bg2"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/subtitle_menu2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Encuentra todas tus reservas realizadas"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/arrow_next2"
                        app:layout_constraintStart_toStartOf="@id/title_menu2"
                        app:layout_constraintTop_toBottomOf="@id/title_menu2" />

                    <!-- Flecha indicativa sutil al final -->
                    <ImageView
                        android:id="@+id/arrow_next2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_flechaderecha"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#94A3B8" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/id_btn_menu_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="cuentaUsuario"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#FFB300"
                app:strokeWidth="5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Icono Modernizado (Fondo circular suave) -->
                    <View
                        android:id="@+id/icon_bg3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/icon_account"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Textos Organizados -->
                    <TextView
                        android:id="@+id/title_menu3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/menu_btn_account"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/arrow_next3"
                        app:layout_constraintStart_toEndOf="@id/icon_bg3"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/subtitle_menu3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Encuentra información de tu cuenta"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/arrow_next3"
                        app:layout_constraintStart_toStartOf="@id/title_menu3"
                        app:layout_constraintTop_toBottomOf="@id/title_menu3" />

                    <!-- Flecha indicativa sutil al final -->
                    <ImageView
                        android:id="@+id/arrow_next3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_flechaderecha"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#94A3B8" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="107dp"
                    android:layout_height="104dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/id_text_user_infoName"
                    app:srcCompat="@mipmap/logo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/id_btn_menu_exit"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="180dp"
                    android:layout_height="58dp"
                    android:layout_marginLeft="13dp"
                    android:layout_marginTop="23dp"
                    android:onClick="salirApp"
                    android:text="@string/menu_btn_exit"
                    android:textAllCaps="true"
                    android:textColor="#1E293B"
                    android:textSize="16dp"
                    app:cornerRadius="29dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/id_text_user_infoName"
                    app:strokeColor="#1E293B"
                    app:strokeWidth="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!--        <androidx.constraintlayout.widget.ConstraintLayout-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="match_parent"-->
        <!--            android:background="@color/white"-->
        <!--            android:padding="16dp">-->

        <!--            -->

        <!--        </androidx.constraintlayout.widget.ConstraintLayout>-->

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>